# MAST production environment. Koyeb injects PORT automatically.
APP_ENV=production
APP_VERSION=1.2.3
NODE_ENV=production
TZ=UTC

# Store all secret values in Koyeb Secrets.
CRON_ADMIN_TOKEN={{ secret.CRON_ADMIN_TOKEN }}
AIMS_API_KEY={{ secret.AIMS_API_KEY }}
RMS_API_KEY={{ secret.RMS_API_KEY }}
ALLOW_PUBLIC_MANUAL_RUNS=false

# Scheduler and HTTP safety limits.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=20
SCHEDULER_STARTUP_TICK_ENABLED=true
REQUEST_TIMEOUT_MS=300000
REQUEST_RETRIES=4
REQUEST_RETRY_BASE_MS=2000
BETWEEN_JOBS_MS=1500
MAST_STATE_BACKEND=r2
ALLOW_EPHEMERAL_STATE=false
STATE_FILE=/tmp/mast-state.json
MAST_STATE_OBJECT_KEY=state/mast/scheduler-state.json
MAST_OPERATOR_CONTROL_OBJECT_KEY=state/mast/operator-control.json
MAST_FAILURE_REVIEW_THRESHOLD=3
MAST_REVIEW_QUEUE_LIMIT=50
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID={{ secret.R2_ACCESS_KEY_ID }}
R2_SECRET_ACCESS_KEY={{ secret.R2_SECRET_ACCESS_KEY }}
R2_BUCKET_META_SYSTEM=metasystem
R2_MAX_ATTEMPTS=2
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_GRACE_MS=10000
HTTP_REQUEST_TIMEOUT_MS=310000
HTTP_HEADERS_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

AIMS_BASE_URL=https://app.jonathan-harris.online
AIMS_PRETRIGGER_CHECKS_ENABLED=true
HIVE_KEEPAWAKE_URL=https://hive.jonathan-harris.online/livez
HIVE_KEEPAWAKE_EVERY_MINUTES=10

# HIVE governance jobs (read-only ecosystem checks + monthly AI Council run).
# HIVE_BASE_URL defaults to https://hive.jonathan-harris.online if unset.
# HIVE_ADMIN_BEARER_TOKEN must match HIVE's own ADMIN_BEARER_TOKEN secret.
HIVE_BASE_URL=https://hive.jonathan-harris.online
HIVE_ADMIN_BEARER_TOKEN={{ secret.HIVE_ADMIN_BEARER_TOKEN }}

# Koyeb power management (cost optimisation): pauses/resumes the AIMS and RAMS Koyeb
# services on a schedule instead of leaving them running (and billed) 24/7.
# KOYEB_TOKEN must have services:write scope - the existing deployment-watch usage only
# needs read access, so check/upgrade the token's scope before enabling this.
# KOYEB_SERVICE_ID_* are Koyeb service IDs (not service names) - find them with
# `koyeb services get <name>` or in the Koyeb dashboard service settings.
# Set KOYEB_POWER_MANAGEMENT_ENABLED=false to disable the feature without a redeploy.
KOYEB_POWER_MANAGEMENT_ENABLED=true
KOYEB_TOKEN={{ secret.KOYEB_TOKEN }}
KOYEB_SERVICE_ID_AIMS={{ secret.KOYEB_SERVICE_ID_AIMS }}
KOYEB_SERVICE_ID_RAMS={{ secret.KOYEB_SERVICE_ID_RAMS }}

# Central HIVE operational alerts.
OPS_ALERT_WEBHOOK_URL=https://hive.jonathan-harris.online/v1/ops/events
OPS_ALERT_WEBHOOK_TOKEN={{ secret.OPS_EVENT_INGEST_TOKEN }}
OPS_ALERT_TIMEOUT_MS=8000

# Optional direct endpoint overrides. Blank values use the governed source defaults.

# Consolidated AIMS operation windows.
# AIMS wakes at 08:30, morning work begins at 09:00, and AIMS returns to standby
# immediately when the AM window completes. Friday wakes again at 14:30 for podcast only.
MAST_AM_OPERATION_TIME=09:00
MAST_FRIDAY_PM_OPERATION_TIME=15:00
MAST_WEBSITE_AUDIT_WAKE_TIME=08:30
MAST_WEBSITE_AUDIT_RUN_TIME=09:00
MAST_WEBSITE_AUDIT_WAKE_CATCH_UP_MINUTES=120
MAST_WEBSITE_AUDIT_RUN_CATCH_UP_MINUTES=180
