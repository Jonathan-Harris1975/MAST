# Koyeb will provide PORT automatically for Web Services.
PORT=8000
NODE_ENV=production
TZ=UTC

# Keep this service private-ish. Manual run endpoints require this token when set.
CRON_ADMIN_TOKEN=replace-with-a-long-random-string

# Downstream bearer auth. Keep these in Koyeb secrets, not Hookdeck settings.
AIMS_API_KEY={{secret.AIMS_API_KEY}}
RMS_API_KEY={{secret.RMS_API_KEY}}

# Scheduler behaviour
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=20
REQUEST_TIMEOUT_MS=300000
REQUEST_RETRIES=4
REQUEST_RETRY_BASE_MS=2000
BETWEEN_JOBS_MS=1500
STATE_FILE=/tmp/koyeb-cron-control-state.json

# Event-aware AIMS pretrigger checks. MAST automatically creates health/preflight/warmup checks
# from the real scheduled AIMS jobs, so changing a job time moves its checks automatically.
AIMS_BASE_URL=https://app.jonathan-harris.online
AIMS_PRETRIGGER_CHECKS_ENABLED=true

# Optional: override the Hookdeck endpoints without editing source.
# The code includes fallbacks copied from the current Cloudflare workers so the migration is low-friction.
HOOK_RSS_REWRITE=
HOOK_OUTREACH_BATCH_NEXT=
HOOK_PODCAST_RUN=
HOOK_BLOG_WEEKLY_BUILD=
HOOK_BLOG_DAILY_SOCIAL_BUILD=
HOOK_ONEUP_MONDAY=
HOOK_ONEUP_TUESDAY=
HOOK_ONEUP_WEDNESDAY=
HOOK_ONEUP_THURSDAY=
HOOK_ONEUP_FRIDAY=
HOOK_ONEUP_SATURDAY=
HOOK_ONEUP_SUNDAY=
HOOK_ONEUP_WEEKLY_QUIZ=
HOOK_AUDIT_SEO_AEO_GEO=
HOOK_AUDIT_ON_BRAND=
HOOK_AUDIT_MOBILE_UX=
HOOK_AUDIT_PODCAST_WEBSITE=
HOOK_AUDIT_SOCIAL_PERFORMANCE=
HOOK_AUDIT_BRAND_SOCIAL_COUNCIL=
HOOK_AUDIT_SEO_AEO_GEO_COUNCIL=
HOOK_AUDIT_MOBILE_UX_COUNCIL=
HOOK_ONEUP_EBOOKS_WEEKLY=
HOOK_HEALTH_PING=

# Optional RAMS endpoints. Health/readiness can call the service directly; rebuild/report rows may use Hookdeck fallbacks.
HOOK_RAMS_HEALTH=
HOOK_RAMS_READINESS=
HOOK_RAMS_REBUILD_SEO_AEO_GEO=
HOOK_RAMS_REBUILD_MOBILE_UX=
HOOK_RAMS_REBUILD_ON_BRAND=
HOOK_RAMS_REPORT_MOBILE_UX_LATEST=
HOOK_RAMS_REPORT_SEO_AEO_GEO_LATEST=
HOOK_RAMS_REPORT_ON_BRAND_LATEST=
# Optional Blotato weekly social-video Hookdeck endpoints.
# These should point to Hookdeck source URLs, not the raw AIMS publish-now URLs.
HOOK_BLOTATO_NEWS_INSIGHT_URL=
HOOK_BLOTATO_MODEL_VERDICT_URL=
HOOK_BLOTATO_AI_AT_WORK_URL=
HOOK_BLOTATO_REALITY_CHECK_URL=
HOOK_BLOTATO_AI_PLAYBOOK_URL=


# HIVE keep-awake for Koyeb free web service. MAST pings /healthz on a gentle interval.
HIVE_KEEPAWAKE_URL=https://liable-loreen-jonathanharris-57884580.koyeb.app/healthz
HIVE_KEEPAWAKE_EVERY_MINUTES=10
