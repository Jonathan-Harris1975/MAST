# Koyeb will provide PORT automatically for Web Services.
PORT=8000
NODE_ENV=production
TZ=UTC

# Keep this service private-ish. Manual run endpoints require this token when set.
CRON_ADMIN_TOKEN=replace-with-a-long-random-string

# Scheduler behaviour
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=20
REQUEST_TIMEOUT_MS=60000
REQUEST_RETRIES=2
REQUEST_RETRY_BASE_MS=2500
BETWEEN_JOBS_MS=1500
STATE_FILE=/tmp/koyeb-cron-control-state.json

# Optional: override the Hookdeck endpoints without editing source.
# The code includes fallbacks copied from the current Cloudflare workers so the migration is low-friction.
HOOK_RSS_REWRITE=
HOOK_OUTREACH_BATCH_NEXT=
HOOK_PODCAST_RUN=
HOOK_BLOG_WEEKLY_BUILD=
HOOK_BLOG_DAILY_SOCIAL_BUILD=
HOOK_ONEUP_MONDAY=
HOOK_ONEUP_TUESDAY=
HOOK_ONEUP_WEDNESDAY=
HOOK_ONEUP_THURSDAY=
HOOK_ONEUP_FRIDAY=
HOOK_ONEUP_SATURDAY=
HOOK_ONEUP_SUNDAY=
HOOK_ONEUP_WEEKLY_QUIZ=
HOOK_AUDIT_SEO_AEO_GEO=
HOOK_AUDIT_ON_BRAND=
HOOK_AUDIT_MOBILE_UX=
HOOK_ONEUP_EBOOKS_WEEKLY=
HOOK_HEALTH_PING=
